          <a class="nav-link active"  href="/signup"><b>SignUp</b></a>
          <a class="nav-link" href="/login"><b>Login</b></a>
        <% } else {%>
          <a class="nav-link" href="/logout"><b>Logout</b></a>
        <% } %>
      </div>
      <div class="navbar-nav theme">
        <span class="theme-open"><b>Theme</b></span>
        <div class="theme-options">
          <div class="light">
            <input type="radio" name="mode" id="light">Light
          </div>
          <div class="dark">
            <input type="radio" name="mode" id="dark">Dark
          </div>
        </div>
      </div>
    </div>
